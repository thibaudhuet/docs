{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SIMCEL Developers",
  "colors": {
    "primary": "#24333F",
    "light": "#3d5568",
    "dark": "#141e25"
  },
  "favicon": "/images/favicon.png",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.png"
  },
  "navbar": {
